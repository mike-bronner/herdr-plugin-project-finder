# Key bindings and the legend above the list. Space is deliberately NOT bound:
# it is fzf's AND separator between query terms, so binding it to toggle flips
# rows while you type a multi-word filter. Tab is fzf's own toggle key and is
# left at its default. The legend must keep agreeing with what is bound here.
KEYS = "ctrl-a:select-all,ctrl-d:deselect-all"
HEADER = ("enter apply  ·  tab toggle  ·  ctrl-a all  ·  ctrl-d none  ·  esc cancel\n"
          "checked = open  ·  unchecked open projects are closed on enter\n"
          " ")   # fzf trims a trailing empty line; a space survives

# fzf prints the line under the cursor when Enter is hit with nothing selected.
# The enter binding queues this sentinel in that case so an intentionally empty
# selection can be told apart from "open the highlighted project".
EMPTY = "__pick_project_empty__"

# Popups do not load ~/.zshrc, and /opt/homebrew/bin is absent from the system
# default PATH, so Homebrew binaries are otherwise unfindable here.
for d in ("/opt/homebrew/bin", "/usr/local/bin"):
    if os.path.isdir(d) and d not in os.environ["PATH"].split(":"):
        os.environ["PATH"] = d + ":" + os.environ["PATH"]

HERDR = os.environ.get("HERDR_BIN_PATH") or shutil.which("herdr")

# Name of the first tab in every workspace the picker opens.
TAB_LABEL = "agent"


def die(msg):
    sys.stderr.write(f"\n\033[31merror:\033[0m {msg}\n\nPress enter to close...")
    try:
        input()
    except Exception:
        time.sleep(5)
    sys.exit(1)


def fzf_installer():
    """(argv, may_we_run_it) for installing fzf here, or (None, False).

    Only a privilege-free installer is ours to run. Asking for a sudo password
    from a popup pane is both hostile and unreliable, so a command that needs
    one is printed for the user to run themselves instead.
    """
    if shutil.which("brew"):
        return ["brew", "install", "fzf"], True
    for mgr, argv in (("apt-get", ["sudo", "apt-get", "install", "-y", "fzf"]),
                      ("dnf", ["sudo", "dnf", "install", "-y", "fzf"]),
                      ("pacman", ["sudo", "pacman", "-S", "--noconfirm", "fzf"])):
        if shutil.which(mgr):
            return argv, False
    return None, False


def install_advice(argv):
    """What to tell someone who has to install fzf by hand."""
    if argv:
        return "Install it with:\n\n    " + " ".join(argv) + "\n"
    return "See https://github.com/junegunn/fzf#installation\n"


def check_deps(out=None):
    """`--check-deps`: the preflight the manifest's [[build]] step runs.

    Returns a process exit code, 0 when every prerequisite is present. Kept
    non-interactive: a build step has no terminal to prompt at, so it only
    reports. The picker itself offers to install, see ensure_fzf().
    """
    out = out or sys.stderr
    found = shutil.which("fzf")
    if found:
        out.write(f"project-finder: fzf found at {found}\n")
        return 0
    argv, _ = fzf_installer()
    out.write("project-finder requires fzf, which is not on the PATH.\n"
              + install_advice(argv))
    return 1


def ensure_fzf(ask=None):
    """True when fzf is usable, offering to install it when it is not.

    Declining, an installer we may not run, and a failed install all fall
    through to die(), so the picker never starts without its dependency.

    `ask` is resolved here rather than defaulting to `input` in the signature:
    a default is bound once at definition, which would capture the real
    builtin and leave a test that patches `builtins.input` blocking on stdin
    instead of failing.
    """
    ask = ask or input
    if shutil.which("fzf"):
        return True
    argv, runnable = fzf_installer()
    if not runnable:
        die("fzf is required but not installed.\n\n" + install_advice(argv))
    prompt = f"fzf is required and not installed.\nInstall it now with `{' '.join(argv)}`? [y/N] "
    try:
        answer = ask(prompt)
    except Exception:
        answer = ""
    if answer.strip().lower() not in ("y", "yes"):
        die("fzf is required.\n\n" + install_advice(argv))
    sys.stderr.write(f"\nRunning {' '.join(argv)}...\n\n")
    if subprocess.run(argv).returncode != 0 or not shutil.which("fzf"):
        die("installing fzf failed.\n\n" + install_advice(argv))
    return True


def herdr(*args):
    """Run a herdr CLI command and return its parsed JSON result."""
    r = subprocess.run([HERDR, *args], capture_output=True, text=True)
    if r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout).get("result")
    except Exception:
        return None


def repos():
    """Every git repo up to 3 levels under the configured root.

    Deliberately not hardcoded to any grouping folder: repos live both directly
    under the root and inside grouping dirs, and those groupings get
    reorganised. Anything nested inside a repo is skipped, so a submodule or a
    worktree placed inside its parent is not listed twice. A worktree kept
    beside its parent is a project in its own right and is listed, tagged
    "worktree" by kind().

    The third level is Herdr's own worktrees. Herdr creates them at
    <worktrees.directory>/<repo>/<branch-slug>, which is three levels down
    whenever that directory sits under the picker root. Reading [worktrees]
    directory out of config.toml and globbing only there would be cheaper, but
    it would then find worktrees ONLY there, and how deep this walks should not
    hang off one setting. A fourth level is not searched: the depths are
    globbed shallowest first, and each one costs a full stat pass over
    everything at that level, so they are not free to keep adding.

    Globbing shallowest first is also what makes the nested skip below work,
    since a parent is always reached before anything inside it.

    Not a recursive glob, for four reasons. It costs tens of seconds: "**/.git"
    with recursive=True measured between 23 and 37 seconds across runs on an
    80-repo root, against a budget of about 70ms, because it descends every
    node_modules and vendor tree. It found nothing extra on that root either:
    no .git sat deeper than three levels, and the four hits past level two were
    exactly the ones this third level already reaches. It would break the skip
    below, which needs a parent accumulated before its children — banding by
    depth guarantees that and a single flat sort does not, because any name
    sorting below "/" (0x2F) comes out ahead of its own parent, so "a/-x"
    precedes "a". And "**" silently means "*" without recursive=True, so
    "**/*/.git" reads as bounded while being either two levels or unbounded
    depending on a flag set elsewhere.
    """
    out = []
    for depth in ("*", "*/*", "*/*/*"):
        for g in sorted(glob.glob(os.path.join(DEV, depth, ".git"))):
            p = os.path.dirname(g)
            if any(p.startswith(o + os.sep) for o in out):
                continue          # nested inside a repo we already have
            if p not in out:
                out.append(p)
    return out


def elide(text, width):
    """`text` cut to `width` columns, ending in "…" when anything was removed.

    The tail goes rather than the head: these labels are identified by their
    front ("jetstream-profile-picture…"), and a dupe label carries its parent
    dir as a prefix, which head-truncation would be the one thing to destroy.
    The result is never wider than `width`, so a long label cannot push the
    columns after it out of alignment.
    """
    return text if len(text) <= width else text[:width - 1] + "…"


def kind(path):
    """"worktree" for a linked git worktree, otherwise "repo".

    A worktree's .git is a FILE holding a "gitdir:" pointer at the parent
    repo's admin dir, where an ordinary repo's .git is a directory. Telling
    them apart is therefore one stat per row instead of a git subprocess, and
    it still classifies a worktree whose parent repo has been deleted — git
    itself errors out on those.
    """
    return "worktree" if os.path.isfile(os.path.join(path, ".git")) else "repo"


def touched_at(path):
    """Newest of the git index and the newest working-tree file (depth 2)."""
    newest = 0
    try:
        newest = os.path.getmtime(os.path.join(path, ".git", "index"))
    except OSError:
        pass
    skip = {"node_modules", "vendor", ".git"}
    for root, dirs, files in os.walk(path):
        depth = root[len(path):].count(os.sep)
        if depth >= 2:
            dirs[:] = []
        dirs[:] = [d for d in dirs if d not in skip]
        for f in files:
            try:
                m = os.path.getmtime(os.path.join(root, f))
                if m > newest:
                    newest = m
            except OSError:
                pass
    return newest


def human_age(ts, now):
    if not ts:
        return "-"
    d = now - ts
    for cutoff, div, unit in ((3600, 60, "m"), (86400, 3600, "h"),
                              (604800, 86400, "d")):
        if d < cutoff:
            return f"{int(d // div)}{unit} ago"
    return f"{int(d // 604800)}w ago"


def live_agent_names():
    """The agent names Herdr would refuse a new `agent start` for.

    `name` is optional on Herdr's AgentInfo and is ABSENT, not null, for an
    agent Herdr merely DETECTED rather than one started under a name: a
    `claude` typed into a pane by hand, or an agent brought back by
    resume_agents_on_restore. Such an agent holds no name and so cannot be
    collided with, which is why those are dropped rather than seeding the set
    with None. Verified against 0.8.2 on a scratch session: after
    `agent start probe-alpha`, `agent list` carried "name": "probe-alpha", and
    a second agent started by hand in another pane carried no "name" key at all.

    The listing is fetched here rather than passed in so that main() holds no
    copy of this comprehension to drift back to.

    An unreadable listing yields no names, which fails OPEN: the worst outcome
    is one `agent start` refused, against a picker that would otherwise refuse
    to open anything because a cosmetic dedupe could not be resolved.
    """
    agents = (herdr("agent", "list") or {}).get("agents", [])
    return {a["name"] for a in agents if a.get("name")}


def agent_name(label, taken):
    """A Herdr agent name for `label`: [a-z][a-z0-9_-]{0,31}, absent from `taken`.

    Herdr refuses `agent start` under a name a live agent already holds
    (error code agent_name_taken, 0.8.2). create_workspace() fires those
    detached, so a refusal is never seen — it shows up only as one pane of a
    multi-select missing its Claude. Hence the dedupe.

    `taken` is the live names from live_agent_names(), and every name handed
    out is added to it, so one run cannot collide with itself either. Distinct
    labels do normalise together: two that differ only past the 32-character
    cut, or only in a character the substitution folds to "-".
    """
    n = re.sub(r"[^a-z0-9_-]", "-", label.lower()).strip("-") or "agent"
    if not n[0].isalpha():
        n = "a" + n
    n = n[:32]
    base, i = n, 2
    while n in taken:
        suffix = f"-{i}"
        n = base[:32 - len(suffix)] + suffix
        i += 1
    taken.add(n)
    return n


def open_workspaces():
    """(home, others): the pinned home workspace (or None) and every other open
    workspace in sidebar order."""
    ws = (herdr("workspace", "list") or {}).get("workspaces", [])
    home = next((w for w in ws if w.get("label") == HOME_LABEL), None)
    return home, [w for w in ws if w is not home]


def order_rows(labelled, open_ws):
    """(label, path, touched) rows: open projects first in sidebar order, then
    the rest by most recently touched. Open workspaces with no matching repo are
    not listed (they still get closed on accept, since they cannot be selected).

    The touch time is carried on the row rather than looked up again later.
    touched_at() walks each working tree, which is the single largest cost of
    starting the picker, so every repo is walked exactly once per run: sorting
    needs the value here and build_lines() needs it for the TOUCHED column.
    """
    by_label = dict(labelled)
    head = [(w["label"], by_label[w["label"]], touched_at(by_label[w["label"]]))
            for w in open_ws if w["label"] in by_label]
    listed = {l for l, _, _ in head}
    rest = sorted(((l, p, touched_at(p)) for l, p in labelled if l not in listed),
                  key=lambda r: -r[2])
    return head, rest


def preselect_bind(n):
    """fzf --bind that marks the first n rows selected once the list is loaded.

    Must be the load event: start fires before any rows exist, so pos+select
    there is a silent no-op (verified against fzf 0.74 in a pty). load fires
    exactly once for a static list and does not re-fire when the query changes,
    so the positional selects cannot leak onto filtered rows (counted with
    execute-silent in a pty on 0.74.3)."""
    if n <= 0:
        return []
    chain = "+".join(f"pos({i})+select" for i in range(1, n + 1))
    return ["--bind", f"load:{chain}+pos(1)"]


def parse_selection(returncode, stdout):
    """None = cancelled (leave everything alone). [] = deliberately empty.
    Otherwise the chosen repo paths."""
    if returncode == 130:
        return None
    lines = stdout.splitlines()
    if EMPTY in lines:
        return []
    # Split on every tab, not just the first: field 3 (the untruncated label)
    # follows the path, and a maxsplit of 1 would hand back "path\tlabel".
    paths = [f[1] for f in (l.split("\t") for l in lines) if len(f) > 1 and f[1]]
    return paths or None


def plan(selected_labels, open_ws):
    """What to close and what to create so open == selected."""
    keep = set(selected_labels)
    to_close = [w for w in open_ws if w["label"] not in keep]
    open_labels = {w["label"] for w in open_ws}
    to_create = [l for l in selected_labels if l not in open_labels]
    return to_close, to_create


def pick_focus(created_ids, closed_ids, focused_id, surviving_ids, home_id):
    """Newly created wins. If the focused workspace was closed, fall back to the
    first surviving selection, then home. Otherwise leave focus alone."""
    if created_ids:
        return created_ids[-1]
    if focused_id in closed_ids:
        return surviving_ids[0] if surviving_ids else home_id
    return None


def canonical_theme(name):
    """A config theme name folded to its canonical key, or None if unknown.

    Port of canonical_theme_name (src/config/theme.rs:25): lowercase, then
    spaces and underscores to hyphens, then the alias table.
    """
    key = re.sub(r"[ _]", "-", (name or "").strip().lower())
    key = THEME_ALIASES.get(key, key)
    return key if key in PALETTES else None


def parse_color(value):
    """A config colour string as a ratatui colour, in the picker's own shape:
    an int (a 256-colour index) or an (r, g, b) triple.

    Port of parse_color (src/config/theme.rs:155), including its final branch:
    an unrecognised value is cyan, NOT an error. Diverging there would colour a
    typo differently from the sidebar it is meant to match.
    """
    s = (value or "").strip().lower()
    if s in RESET_ALIASES:
        return None                       # SGR 39, the default foreground
    if s.startswith("#"):
        hexpart = s[1:]
        if len(hexpart) == 6 and re.fullmatch(r"[0-9a-f]{6}", hexpart):
            return tuple(int(hexpart[i:i + 2], 16) for i in (0, 2, 4))
        if len(hexpart) == 3 and re.fullmatch(r"[0-9a-f]{3}", hexpart):
            return tuple(int(c, 16) * 17 for c in hexpart)
    m = re.fullmatch(r"rgb\(([^)]*)\)", s)
    if m:
        parts = [p.strip() for p in m.group(1).split(",")]
        if len(parts) == 3 and all(p.isdigit() and int(p) < 256 for p in parts):
            return tuple(int(p) for p in parts)
    return NAMED_COLORS.get(s, NAMED_COLORS["cyan"])


# Every config key resolve_theme() reads, built from the tables above so a role
# added there cannot be silently left unreadable.
THEME_KEYS = frozenset(
    ["ui.status_indicators", "theme.name", "theme.auto_switch", "theme.dark_name"]
    + [f"theme.custom.{r}" for r in STATUS_ROLE_ORDER]
    + [f"theme.custom.dark.{r}" for r in STATUS_ROLE_ORDER])


def herdr_rejects_theme(field):
    """True when Herdr itself will not accept the theme name at `field`.

    `herdr config check` diagnoses an unknown theme name, naming both the field
    and the fallback it uses ("unknown theme name theme.name = ...; using
    "catppuccin""). That is the only way to tell a TYPO apart from a theme newer
    than PALETTES: on a typo Herdr draws its own default, so matching it means
    drawing that default too, while a name Herdr accepts and this table lacks
    means the table is stale.

    Called only when PALETTES has no entry for the name, so the normal path
    never pays for the subprocess. Any failure answers False, which routes to
    UNKNOWN_THEME: a picker that cannot ask must not claim the name was a typo.
    """
    try:
        r = subprocess.run([HERDR, "config", "check"], capture_output=True, text=True)
    except OSError:
        return False
    return f"unknown theme name {field}" in (r.stdout + r.stderr)


def resolve_theme(config=None, rejects=None):
    """(icons, colours) for the current Herdr config.

    `icons` maps a status to its glyph, `colours` maps a status to a colour in
    parse_color()'s shape. Reads [ui] status_indicators, [theme] name, and any
    [theme.custom] override of the five status roles.

    auto_switch is the one thing this cannot follow. Herdr picks between
    dark_name and light_name from the HOST TERMINAL's appearance, which it
    learns over the client connection and does not expose on the API or the
    CLI. A popup pane has no way to ask. When auto_switch is on, dark_name is
    used (Herdr's own dark default, and the overwhelmingly common case for a
    terminal), and [theme.custom.dark] overrides are applied with it.
    """
    if config is None:
        config = read_toml(herdr_config_path(), THEME_KEYS)
    rejects = rejects or herdr_rejects_theme
    style = config.get("ui.status_indicators", "dots")
    icons = STATUS_ICONS.get(style, STATUS_ICONS["dots"])

    auto = config.get("theme.auto_switch", "false").strip().lower() == "true"
    field = "theme.dark_name" if auto else "theme.name"
    name = config.get(field)
    key = canonical_theme(name)
    if key is None:
        # Unset means Herdr's default. A name Herdr also rejects means Herdr is
        # drawing that same default, so match it. A name Herdr accepts and this
        # table lacks is a stale table, which is what UNKNOWN_THEME is for.
        key = DEFAULT_THEME if not name or rejects(field) else UNKNOWN_THEME
    palette = PALETTES[key]

    roles = dict(zip(STATUS_ROLE_ORDER, palette))
    # A mode override wins over the unqualified one, matching the order
    # with_overrides() applies them (src/app/state.rs:551).
    tables = ["theme.custom"] + (["theme.custom.dark"] if auto else [])
    for role in STATUS_ROLE_ORDER:
        for table in tables:
            if f"{table}.{role}" in config:
                roles[role] = config[f"{table}.{role}"]

    colours = {}
    for status, role in STATUS_ROLES.items():
        value = roles[role]
        # A built-in Rgb is already in shape; a named colour and every config
        # override are strings that still need parsing.
        colours[status] = value if isinstance(value, tuple) else parse_color(value)
    return icons, colours


def paint(text, colour):
    """`text` wrapped in the SGR foreground escape ratatui would have written."""
    if colour is None:
        code = "39"
    elif isinstance(colour, tuple):
        code = "38;2;%d;%d;%d" % colour
    else:
        code = f"38;5;{colour}"
    return f"\033[{code}m{text}\033[39m"


def status_cell(status, icons, colours):
    """The AGENT STATUS column for one open workspace: Herdr's glyph and colour,
    then the status word.

    The word is kept even though Herdr's sidebar shows the glyph alone, because
    fzf searches the visible text: typing "blocked" has to narrow the list. The
    visible text is padded to STATUS_WIDTH before the escapes go on, since ROW
    cannot pad a string whose length it would measure wrongly.
    """
    icon = icons.get(status, icons["unknown"])
    # .get() would be wrong here: a reset colour is legitimately None, so a
    # status Herdr adds later must fall back explicitly, not by absence.
    colour = colours[status] if status in colours else colours["unknown"]
    return paint(f"{icon} {status}".ljust(STATUS_WIDTH), colour)


def build_lines(rows, status, now):
    """One fzf input line per (label, path, touched) row, in the order given.

    Field 1 holds the visible columns, with the label elided so a long name
    cannot push the columns after it out of alignment. Fields 2 and 3 are
    hidden payload the preview reads: the repo path, then the label again,
    untruncated, since field 1 may have lost the end of it.

    `status` maps an open workspace's label to its rendered AGENT STATUS cell,
    already glyphed, coloured and padded by status_cell(). A row absent from it
    is not open and gets a blank column.

    The touch time arrives on the row from order_rows(). Nothing here may reach
    for the filesystem to recompute it: doing so walks every working tree a
    second time and doubles the wait before the picker paints.
    """
    lines = []
    for label, path, touched in rows:
        lines.append(ROW.format(elide(label, LABEL_WIDTH), kind(path),
                                human_age(touched, now), status.get(label, ""),
                                path, label))
    return lines


def create_workspace(label, path, live):
    """Open a workspace for `path` with the agent layout; return its workspace id.

    The first tab arrives with the workspace and cannot be labelled at creation
    (`workspace create --label` names the workspace), so it is renamed to
    TAB_LABEL right after. It is then split Claude (left) | shell (right).

    `live` is the set of agent names already spoken for, and is MUTATED: the
    name this call takes is reserved in it, so the caller's next create sees it.
    """
    res = herdr("workspace", "create", "--cwd", path, "--label", label, "--no-focus")
    if not res:
        die(f"failed to create workspace for {path}")

    tab = res.get("tab", {}).get("tab_id")
    if tab:
        herdr("tab", "rename", tab, TAB_LABEL)

    pane = res.get("root_pane", {}).get("pane_id")
    if pane:
        herdr("pane", "split", "--pane", pane,
              "--direction", "right", "--ratio", "0.5", "--cwd", path)
        # Fire and forget. `agent start` blocks until the agent is ready
        # (default 30s), which would stall the picker on a multi-select —
        # detaching makes that wait free. Note --timeout has a 3000ms
        # MINIMUM, so a short value is rejected outright; omit it instead.
        subprocess.Popen([HERDR, "agent", "start", agent_name(label, live),
                          "--kind", "claude", "--pane", pane],
                         start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return res["workspace"]["workspace_id"]


def main():
    if not HERDR:
        die("herdr not found on PATH")
    ensure_fzf()

    paths = repos()
    if not paths:
        die(f"No git repositories found under {DEV}")

    # Basenames appearing more than once get a parent prefix to stay unique.
    seen, dupes = set(), set()
    for p in paths:
        b = os.path.basename(p)
        (dupes if b in seen else seen).add(b)

    def label_for(p):
        b = os.path.basename(p)
        return f"{os.path.basename(os.path.dirname(p))}/{b}" if b in dupes else b

    _, open_ws = open_workspaces()
    icons, colours = resolve_theme()
    status = {w["label"]: status_cell(w.get("agent_status", "unknown"), icons, colours)
              for w in open_ws}
    head, rest = order_rows([(label_for(p), p) for p in paths], open_ws)

    lines = build_lines(head + rest, status, time.time())

    sel = subprocess.run(
        # --ansi: the AGENT STATUS cell carries Herdr's own colour escapes.
        # Without it fzf prints them literally and the columns fall apart.
        ["fzf", "--ansi", "--delimiter=\t", "--with-nth=1", "--nth=1", "--layout=reverse",
         "--multi", "--prompt=filter projects > ",
         "--header=" + HEADER,
         "--bind", KEYS,
         "--bind", f"enter:transform:[ \"$FZF_SELECT_COUNT\" -eq 0 ] "
                   f"&& echo 'print({EMPTY})+accept' || echo accept",
         *preselect_bind(len(head)),
         "--header-lines=1",
         # No pointer glyph: the whole current row is highlighted instead.
         # Selected rows get a green check; fzf has no unselected marker, so
         # that column is simply blank on the rest.
         "--marker=\u2713 ", "--color=marker:green",
         "--pointer= ", "--gutter= ", "--highlight-line",
         "--height=100%", "--info=inline",
         # The label heads the preview because field 1 may be elided: this is
         # the only place a truncated name can be read in full. fzf quotes {3}
         # and {2} for the shell, so no quoting is needed around them here.
         "--preview", "printf '%s\\n\\n' {3}; "
                      "git -C {2} log --oneline -8 2>/dev/null || ls -1 {2}",
         "--preview-window=right:52%:wrap"],
        input="\n".join([HEADING] + lines), capture_output=True, text=True)

    chosen = parse_selection(sel.returncode, sel.stdout)
    if chosen is None:
        return

    # Re-read: the list may have changed while the picker was open.
    home, open_ws = open_workspaces()
    selected = [label_for(p) for p in chosen]
    to_close, to_create = plan(selected, open_ws)
    path_of = {label_for(p): p for p in chosen}

    closed = []
    for w in to_close:
        if herdr("workspace", "close", w["workspace_id"]) is not None:
            closed.append(w["workspace_id"])

    # Read after the closes above, so a name the user just freed is reusable.
    # One set for the whole batch: agent start is fired detached and does not
    # land in `agent list` before the next create, so agent_name() reserving
    # into this set is the only thing keeping two new workspaces apart.
    live = live_agent_names()
    created = [create_workspace(label, path_of[label], live) for label in to_create]

    focused = next((w["workspace_id"] for w in open_ws if w.get("focused")), None)
    surviving = [w["workspace_id"] for w in open_ws
                 if w["label"] in set(selected) and w["workspace_id"] not in closed]
    target = pick_focus(created, closed, focused, surviving,
                        home["workspace_id"] if home else None)
    if target:
        subprocess.run([HERDR, "workspace", "focus", target], capture_output=True)


if __name__ == "__main__":
    # --check-deps is the manifest's [[build]] entry point. It must never open
    # the picker: a build step has no terminal to draw one in.
    if "--check-deps" in sys.argv[1:]:
        sys.exit(check_deps())
    main()
