#!/usr/bin/env python3
"""Fuzzy-pick git repos under a root folder and make them the open Herdr workspaces.

The list is the desired set of open projects. Everything already open (other
than the pinned home workspace) is listed first and pre-selected, so what you
see checked is exactly what is loaded. On Enter the selection becomes the
truth: deselected projects are closed, newly selected ones are created, and an
empty selection closes every project so only home remains. Esc changes nothing.

The search root is HERDR_PICKER_ROOT, defaulting to the home folder. The home
workspace (label "~", override with HERDR_PICKER_HOME) is never listed and
never closed.

Both settings may also come from a .env file under HERDR_PLUGIN_CONFIG_DIR;
real environment variables take precedence over that file.

Each open project's row carries its agent status, drawn with the glyph and
colour Herdr's own sidebar would use, read out of Herdr's config.toml. See the
"Herdr's agent-status indicator" section below.

Each new workspace opens one tab named "agent", split 50/50: Claude on the
left, a shell on the right. Claude is started plain — Herdr's own [session]
resume_agents_on_restore (on by default) handles bringing conversations back
after a server restart, so the picker does not pass --continue itself.
"""
import glob, json, os, re, shutil, subprocess, sys, time


def load_env(path):
    """Apply KEY=VALUE lines from `path` to os.environ. Real env vars win.

    Blank lines and lines starting with "#" are skipped, and so is any line
    without an "=". The skip is deliberate: the file is optional user config,
    so a typo must never stop the picker from opening.
    """
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key, value = key.strip(), value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        if key:
            os.environ.setdefault(key, value)


def read_toml(path, wanted):
    """Values for the "table.key" names in `wanted`, as raw strings.

    A deliberate subset of TOML: scalar values under [table] headers, which is
    every setting read here. Arrays, inline tables and multi-line values are
    skipped rather than half-parsed, and an unreadable file yields {}. Python
    3.9 ships no tomllib and this plugin has no dependencies, so a full parser
    would have to be vendored to read four keys.

    Like load_env(), nothing here may raise: Herdr's config is the user's to
    edit, and a syntax error in it must never stop the picker from opening.
    """
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return {}
    found, table = {}, ""
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            table = line[1:-1].strip().strip('"')
            continue
        key, sep, value = line.partition("=")
        name = f"{table}.{key.strip()}"
        if not sep or name not in wanted:
            continue
        value = value.strip()
        if value[:1] in "\"'":
            # Quoted: take up to the closing quote, so a trailing comment that
            # contains no quote cannot be glued onto the value.
            end = value.find(value[0], 1)
            value = value[1:end] if end > 0 else value[1:]
        else:
            value = value.partition("#")[0].strip()
        if value and not value.startswith(("[", "{")):
            found.setdefault(name, value)
    return found


def herdr_config_path():
    """Herdr's own config.toml.

    HERDR_CONFIG_PATH wins, because Herdr documents it as the override for this
    exact file (`herdr --help`) and the server is reading whatever it names.
    Otherwise it is derived from the plugin config dir Herdr passes in, which is
    <config root>/plugins/config/<plugin id>, so a relocated config root is
    followed rather than guessed at. Failing both, the documented default.
    """
    override = os.environ.get("HERDR_CONFIG_PATH")
    if override:
        return os.path.expanduser(override)
    d = os.environ.get("HERDR_PLUGIN_CONFIG_DIR")
    if d:
        root = os.path.dirname(os.path.dirname(os.path.dirname(d.rstrip(os.sep))))
        candidate = os.path.join(root, "config.toml")
        if os.path.isfile(candidate):
            return candidate
    return os.path.expanduser("~/.config/herdr/config.toml")


def resolve_root():
    """Where to look for repos: HERDR_PICKER_ROOT, else the home folder.

    A leading "~" is expanded, since .env values are not shell-expanded. A root
    that is not an existing directory falls back to the home folder rather than
    dying, so a stale override still leaves the picker usable.
    """
    root = os.path.expanduser(os.environ.get("HERDR_PICKER_ROOT") or "~")
    return root if os.path.isdir(root) else os.path.expanduser("~")


# User-editable config lives in the plugin's config dir, per the Herdr docs.
# Loaded before the settings below so the file can supply them.
if os.environ.get("HERDR_PLUGIN_CONFIG_DIR"):
    load_env(os.path.join(os.environ["HERDR_PLUGIN_CONFIG_DIR"], ".env"))

DEV = resolve_root()
HOME_LABEL = os.environ.get("HERDR_PICKER_HOME", "~")

# Column layout for the list. The heading is built from the same format string
# as every row, so the two cannot drift out of alignment. Only field 1 is shown
# (--with-nth=1); the two tab-separated fields after it are hidden payload that
# the preview reads — field 2 is the repo path, field 3 the untruncated label.
#
# Field 3 exists for the preview alone, NOT for filtering. fzf calculates --nth
# against the transformed line, so a hidden field cannot be searched at all:
# "fzf doesn't allow searching against the hidden fields" (fzf(1), --nth). The
# preview is the exception, and reads fields from the original line. So a label
# elide() cuts is unmatchable past the ellipsis, and the preview showing it in
# full is the compensation.
#
# KIND is spelled out rather than iconified because fzf searches the visible
# field, so typing "worktree" filters the list to worktrees.
LABEL_WIDTH = 34
STATUS_WIDTH = 12
ROW = f"{{:<{LABEL_WIDTH}}} {{:<9}} {{:<9}} {{}}\t{{}}\t{{}}"
HEADING = ROW.format("PROJECT", "KIND", "TOUCHED", "AGENT STATUS", "", "")

# The AGENT STATUS field is NOT padded by ROW. It carries colour escapes, and
# str.format pads by character count, so a padded format spec would count the
# escapes and pad by the wrong amount. status_cell() pads the visible text to
# STATUS_WIDTH before wrapping it. Nothing visible follows the field, so this
# costs no alignment either way — it is done so the width stays one number.

