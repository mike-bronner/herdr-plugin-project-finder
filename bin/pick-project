          "checked = open  ·  unchecked open projects are closed on enter\n"
          " ")   # fzf trims a trailing empty line; a space survives

# fzf prints the line under the cursor when Enter is hit with nothing selected.
# The enter binding queues this sentinel in that case so an intentionally empty
# selection can be told apart from "open the highlighted project".
EMPTY = "__pick_project_empty__"

# Popups do not load ~/.zshrc, and /opt/homebrew/bin is absent from the system
# default PATH, so Homebrew binaries are otherwise unfindable here.
for d in ("/opt/homebrew/bin", "/usr/local/bin"):
    if os.path.isdir(d) and d not in os.environ["PATH"].split(":"):
        os.environ["PATH"] = d + ":" + os.environ["PATH"]

HERDR = os.environ.get("HERDR_BIN_PATH") or shutil.which("herdr")

# The plugin that owns the three-pane layout, by the id in ITS manifest. The
# picker builds no part of that layout: it opens a workspace and hands the id to
# herdr-plugin-agentic-panes-layout's bin/agent-layout, which the sibling also
# runs from its own worktree.created hook and from a keybinding.
#
# NO AGENT_LAYOUT_ SETTING IS READ HERE, and that is the point of delegating.
# The ten of them — _KIND, _TAB_NAME, _DIRECTION, _RATIO, _TOOL_COMMAND,
# _TOOL_DIRECTION, _TOOL_RATIO, _AGENT_LABEL, _TOOL_LABEL and _SHELL_LABEL — are
# one shared vocabulary documented in both READMEs, and the sibling reads them
# for both plugins now. A value set in THIS plugin's .env still reaches it: the
# loaders at the top of this file fold that .env into os.environ, and
# layout_env() passes the environment through, where the sibling's own reader
# lets a real environment variable beat its .env. So a name set here still wins
# here, and the sibling's .env now covers what this one leaves unset.
#
# _RECIPE is the one name in that vocabulary neither plugin honours here: it
# replaces the sibling's layout with an executable of the user's, and it is read
# by the sibling's EVENT HOOK, which decides what to exec before bin/agent-layout
# is reached. This picker runs bin/agent-layout directly, so it is not in the
# path that setting sits on.
LAYOUT_PLUGIN = "mikebronner.agentic-panes-layout"


def die(msg):
    sys.stderr.write(f"\n\033[31merror:\033[0m {msg}\n\nPress enter to close...")
    try:
        input()
    except Exception:
        time.sleep(5)
    sys.exit(1)


def warn(msg):
    """Tell the user something is wrong, without stopping the run.

    Two channels, because neither alone reaches anybody. The picker is a POPUP
    pane that closes when this process exits, so anything written to stderr at
    the end of a run is gone before it can be read; the Herdr toast is what the
    user actually sees. stderr is still written because that is what lands in
    `herdr plugin log list`, which is where the message is read afterwards.

    The toast is best effort and its failure is ignored — a picker that cannot
    raise a notification must still finish opening the workspaces. die() is the
    other half of this pair, for what is worth stopping over.

    Call this only where fzf is not on the screen, the rule debug_discovery()
    states in full: fzf paints over the whole pane, so a write arriving
    mid-render garbles the list.
    """
    sys.stderr.write(f"picker: {msg}\n")
    subprocess.run([HERDR, "notification", "show", "project finder",
                    "--body", msg], capture_output=True)


def fzf_installer():
    """(argv, may_we_run_it) for installing fzf here, or (None, False).

    Only a privilege-free installer is ours to run. Asking for a sudo password
    from a popup pane is both hostile and unreliable, so a command that needs
    one is printed for the user to run themselves instead.
    """
    if shutil.which("brew"):
        return ["brew", "install", "fzf"], True
    for mgr, argv in (("apt-get", ["sudo", "apt-get", "install", "-y", "fzf"]),
                      ("dnf", ["sudo", "dnf", "install", "-y", "fzf"]),
                      ("pacman", ["sudo", "pacman", "-S", "--noconfirm", "fzf"])):
        if shutil.which(mgr):
            return argv, False
    return None, False


def install_advice(argv):
    """What to tell someone who has to install fzf by hand."""
    if argv:
        return "Install it with:\n\n    " + " ".join(argv) + "\n"
    return "See https://github.com/junegunn/fzf#installation\n"


def check_deps(out=None):
    """`--check-deps`: the preflight the manifest's [[build]] step runs.

    Returns a process exit code, 0 when every prerequisite is present. Kept
    non-interactive: a build step has no terminal to prompt at, so it only
    reports. The picker itself offers to install, see ensure_fzf().
    """
    out = out or sys.stderr
    found = shutil.which("fzf")
    if found:
        out.write(f"project-finder: fzf found at {found}\n")
        return 0
    argv, _ = fzf_installer()
    out.write("project-finder requires fzf, which is not on the PATH.\n"
              + install_advice(argv))
    return 1


def ensure_fzf(ask=None):
    """True when fzf is usable, offering to install it when it is not.

    Declining, an installer we may not run, and a failed install all fall
    through to die(), so the picker never starts without its dependency.

    `ask` is resolved here rather than defaulting to `input` in the signature:
    a default is bound once at definition, which would capture the real
    builtin and leave a test that patches `builtins.input` blocking on stdin
    instead of failing.
    """
    ask = ask or input
    if shutil.which("fzf"):
        return True
    argv, runnable = fzf_installer()
    if not runnable:
        die("fzf is required but not installed.\n\n" + install_advice(argv))
    prompt = f"fzf is required and not installed.\nInstall it now with `{' '.join(argv)}`? [y/N] "
    try:
        answer = ask(prompt)
    except Exception:
        answer = ""
    if answer.strip().lower() not in ("y", "yes"):
        die("fzf is required.\n\n" + install_advice(argv))
    sys.stderr.write(f"\nRunning {' '.join(argv)}...\n\n")
    if subprocess.run(argv).returncode != 0 or not shutil.which("fzf"):
        die("installing fzf failed.\n\n" + install_advice(argv))
    return True


def herdr(*args):
    """Run a herdr CLI command and return its parsed JSON result."""
    r = subprocess.run([HERDR, *args], capture_output=True, text=True)
    if r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout).get("result")
    except Exception:
        return None


def debug_discovery(elapsed, paths, counts, out=None):
    """Report what repos() cost and what it found, one line, when asked to.

    Silent unless HERDR_PICKER_DEBUG holds something, which is the whole point:
    every normal run must write nothing at all, because this is a popup pane and
    unbidden output sits on top of the thing the user opened. Read from
    os.environ like the other settings here, so either config file the loaders
    at the top fold into it can turn this on for good.

    `elapsed` is discovery's elapsed time in SECONDS, reported as milliseconds.
    Those are the units the figures quoted in repos() are in, and a tenth of a
    millisecond is already finer than the run-to-run spread.

    The two passes are named by WHERE THEY LOOK, not by what they return.
    Calling the first figure "repos" would be false on a real tree: the depth
    bands find worktrees too, every one that falls within three levels of the
    root and carries no leading dot on the way. Herdr's flat
    <root>/worktrees/<repo>/<slug> is that, and so is a "../worktrees"
    container beside a repo directly under the root. Only the container pass is
    worktrees exclusively, and the two are counted where they were FOUND, not
    where they belong. Each figure reads "N from X"
    rather than "N Xs" so that a count of one needs no singular form. `paths`
    supplies the row total rather than a sum of the two, so the line reports
    what was actually listed.

    Call this only where fzf is not on the screen. fzf paints the popup over the
    whole pane, so a write arriving mid-render garbles the list the user is
    trying to read. The rule every writer in this file keeps, rather than a list
    of them: none runs inside fzf's lifetime. They write before it starts or
    after it has exited, and this one is on the near side of that call.
    """
    if not os.environ.get("HERDR_PICKER_DEBUG"):
        return
    (out or sys.stderr).write(
        f"picker: discovery {elapsed * 1000:.1f}ms, {len(paths)} rows "
        f"({counts['bands']} from depth bands, "
        f"{counts['containers']} from worktree containers)\n")


def repos(counts=None):
    """Every git repo up to 3 levels under the root, plus the worktrees kept in
    a container resolved against each of them.

    Two passes, because the two things live in different places.

    The first is the depth bands. Deliberately not hardcoded to any grouping
    folder: repos live both directly under the root and inside grouping dirs,
    and those groupings get reorganised. Anything nested inside a repo is
    skipped there, so a submodule or a vendored checkout is not listed twice.
    A worktree kept beside its parent is a project in its own right and is
    listed, tagged "worktree" by row_kind(). A fourth level is not searched: the
    depths are globbed shallowest first, and each one costs a full stat pass
    over everything at that level, so they are not free to keep adding — a
    fourth measured 93-164ms across runs on the real 85-repo root, against
    18ms for the three kept, and matched nothing at all.

    Globbing shallowest first is also what makes the nested skip work, since a
    parent is always reached before anything inside it.

    The second pass is the exemption to that skip, and the only one: a LINKED
    WORKTREE in a well-known container is listed. A container is a relative
    path RESOLVED AGAINST each repo root, which is what makes one pass serve
    every layout on this machine however differently each places the checkout:
    Herdr's <repo>/.worktrees/<repo>/<slug> while its [worktrees] directory is
    ".worktrees", Claude Code's <repo>/.claude/worktrees/<slug>, which carries
    one level fewer, and Herdr's <parent>/worktrees/<repo>/<slug> once that
    setting becomes "../worktrees" — the value that keeps checkouts out of the
    repo entirely, so that no filesystem-walking tool descends into them. The
    skip alone lost every one of them. The containers come from
    worktree_locations(): fixed names plus whatever Herdr's own setting adds,
    so the picker follows that setting without hanging off it. Only
    row_kind() == "worktree" is admitted, which is what keeps the exemption from
    re-admitting the submodule the skip exists for.

    A DOTTED container is unreachable by the depth bands whatever the number:
    glob never matches a leading dot with a wildcard, so ".worktrees" and
    ".claude" are invisible to "*/*/*". An undotted one is reachable whenever
    it happens to fall within three levels, which is why the loop below tests
    `w not in out` rather than assuming a fresh path — "../worktrees" beside a
    repo directly under the root is exactly that case. Naming the containers
    literally is also what makes this cheap. On the real root the two container
    depths under all 85 repos cost 9ms on top of the bands' 18ms, 26ms in total
    against a ~70ms budget. Re-measured there on 2026-09-08, when the setting
    moved beside the repo: 22.5ms in total at ".worktrees" and 23.0ms at
    "../worktrees", so the move costs 0.5ms. Both figures are the whole of
    repos(), which is why they sit below the 26ms recorded for the same tree in
    v0.6.1 rather than contradicting it.

    Not a recursive glob, for four reasons. It costs tens of seconds: "**/.git"
    with recursive=True measured between 23 and 37 seconds across runs on that
    root, because it descends every node_modules and vendor tree. It found
    nothing the two passes here do not, and could not have: the leading-dot
    rule binds "**" as well, so it walks past a .worktrees the same way a band
    does — verified, not assumed. It would break the skip, which needs a
    parent accumulated before its children — banding by depth guarantees that
    and a single flat sort does not, because any name sorting below "/" (0x2F)
    comes out ahead of its own parent, so "a/-x" precedes "a". And "**"
    silently means "*" without recursive=True, so "**/*/.git" reads as bounded
    while being either two levels or unbounded depending on a flag set
    elsewhere.

    `counts` is an optional dict, MUTATED when given: "bands" and "containers"
    receive how many paths each pass contributed. The split is free while the
    passes run and unrecoverable afterwards, since the return value is one flat
    list, and debug_discovery() reports both figures. Nothing that is found
    depends on it.
    """
    out = []
    for depth in ("*", "*/*", "*/*/*"):
        for g in sorted(glob.glob(os.path.join(DEV, depth, ".git"))):
            p = os.path.dirname(g)
            if any(p.startswith(o + os.sep) for o in out):
                continue          # nested inside a repo we already have
            if p not in out:
                out.append(p)
    banded = len(out)

    # Every container layout in one pass, because the two depths cover all of
    # them: Claude Code puts the worktree straight in the container, Herdr puts
    # it under the repo's own name whether the container sits inside the repo
    # or beside it.
    #
    # normpath is what resolves a "../x" container, and dict.fromkeys is what
    # pays for it. A container beside the repo is SHARED by every repo in that
    # parent, so the join produces the same directory once per repo, and the
    # globs below would re-run over it that many times. Deduped first-seen, so
    # the order the appends rely on is unchanged. Measured on the real 85-repo
    # root with directory = "../worktrees": 340 bases collapse to 262, and
    # discovery drops from 28.9ms to 23.0ms. It pays for itself only there: at
    # ".worktrees" all 255 bases are already distinct, and building the dict
    # instead of the list costs 0.3ms for nothing.
    bases = dict.fromkeys(os.path.normpath(os.path.join(p, d))
                          for p in list(out) for d in WORKTREE_DIRS)
    for base in list(bases) + WORKTREE_ROOTS:
        for depth in ("*", "*/*"):
            for g in sorted(glob.glob(os.path.join(base, depth, ".git"))):
                w = os.path.dirname(g)
                if w not in out and row_kind(w) == "worktree":
                    out.append(w)
    if counts is not None:
        # The second pass only ever appends, so the first pass's share is the
        # length taken before it ran.
        counts["bands"], counts["containers"] = banded, len(out) - banded
    return out


def elide(text, width):
    """`text` cut to `width` columns, ending in "…" when anything was removed.

    The tail goes rather than the head: these labels are identified by their
    front ("invoice-pdf-export-service…"), and a dupe label carries its parent
    dir as a prefix, which head-truncation would be the one thing to destroy.
    The result is never wider than `width`, so a long label cannot push the
    columns after it out of alignment.
    """
    return text if len(text) <= width else text[:width - 1] + "…"


def row_kind(path):
    """"worktree" for a linked git worktree, otherwise "repo".

    A worktree's .git is a FILE holding a "gitdir:" pointer at the parent
    repo's admin dir, where an ordinary repo's .git is a directory. Telling
    them apart is therefore one stat per row instead of a git subprocess, and
    it still classifies a worktree whose parent repo has been deleted — git
    itself errors out on those.
    """
    return "worktree" if os.path.isfile(os.path.join(path, ".git")) else "repo"


def parent_repo(path):
    """The root of the repo a linked worktree at `path` belongs to, or None.

    Read out of the worktree's own .git — the FILE row_kind() classifies on.
    It holds one "gitdir:" line naming the parent's admin directory for this
    checkout, which git spells <repo-root>/.git/worktrees/<name>. So the parent
    is three components up from the pointer. Where the checkout itself sits does
    not enter into it, which is why one parse serves every layout on this
    machine: Herdr's nested .worktrees/<repo>/<slug>, Herdr's sibling
    <parent>/worktrees/<repo>/<slug>, Herdr's older flat
    <root>/worktrees/<repo>/<slug>, and Claude Code's .claude/worktrees/<slug>.
    A layout added later needs nothing here.

    One file read and no `git` subprocess, the same trade row_kind() makes
    for the same information, and for the same reason: this is paid per row
    opened.

    None whenever the shape is not exactly that, and the caller then opens the
    checkout unnested. An ordinary repo answers None because its .git is a
    directory, so the read raises before any parsing. A SUBMODULE answers None
    too, and deliberately: its .git is a file as well, so row_kind() calls it a
    worktree, but it points at <super>/.git/modules/<name> and has no worktree
    parent to name. Nothing obliges other tooling to write git's shape either,
    and a wrongly-derived parent is worse than none — it would nest the
    checkout under some unrelated repo.

    A relative pointer is resolved against the checkout. Git writes an absolute
    one by default, but `git worktree add --relative-paths` and the
    worktree.useRelativePaths setting write a relative one, and a relative path
    would then be resolved by Herdr against the wrong directory entirely.
    """
    try:
        with open(os.path.join(path, ".git"), encoding="utf-8") as f:
            pointer = f.read()
    except OSError:
        return None
    key, _, target = pointer.partition("\n")[0].partition(":")
    if key.strip() != "gitdir" or not target.strip():
        return None
    admin = os.path.normpath(os.path.join(path, target.strip()))
    container = os.path.dirname(admin)
    dotgit = os.path.dirname(container)
    if os.path.basename(container) != "worktrees" \
            or os.path.basename(dotgit) != ".git":
        return None
    return os.path.dirname(dotgit)


def touched_at(path):
    """Newest of the git index and the newest working-tree file (depth 2).

    A worktree container is pruned along with the rest: its contents belong to
    the worktrees repos() lists as rows of their own, so counting them here
    would report work done on a branch as work done on its parent. A container
    one level down is where that actually bit, since it puts the worktree's own
    working tree at depth 2 — under the deeper .worktrees/<repo>/<slug> and
    .claude/worktrees/<slug> layouts the files were already past the walk's
    reach. Pruning the container makes it true of every layout, and stops the
    walk entering it at all.

    Pruned by full path, not by name, so ".claude" keeps counting while
    ".claude/worktrees" does not, and a "worktrees" deeper in the tree is left
    alone — a container is only a container where repos() looks for one. That
    same full-path rule makes a container BESIDE the repo, which a "../x"
    setting produces, inert here rather than a special case: it resolves to a
    path the walk below never reaches, and it needs no pruning because a
    sibling directory was never counted as this repo's work in the first place.
    """
    newest = 0
    try:
        newest = os.path.getmtime(os.path.join(path, ".git", "index"))
    except OSError:
        pass
    skip = {"node_modules", "vendor", ".git"}
    trees = {os.path.normpath(os.path.join(path, d)) for d in WORKTREE_DIRS}
    for root, dirs, files in os.walk(path):
        depth = root[len(path):].count(os.sep)
        if depth >= 2:
            dirs[:] = []
        dirs[:] = [d for d in dirs if d not in skip
                   and os.path.join(root, d) not in trees]
        for f in files:
            try:
                m = os.path.getmtime(os.path.join(root, f))
                if m > newest:
                    newest = m
            except OSError:
                pass
    return newest


def human_age(ts, now):
    if not ts:
        return "-"
    d = now - ts
    for cutoff, div, unit in ((3600, 60, "m"), (86400, 3600, "h"),
                              (604800, 86400, "d")):
        if d < cutoff:
            return f"{int(d // div)}{unit} ago"
    return f"{int(d // 604800)}w ago"


def open_workspaces():
    """(home, others): the pinned home workspace (or None) and every other open
    workspace in sidebar order."""
    ws = (herdr("workspace", "list") or {}).get("workspaces", [])
    home = next((w for w in ws if w.get("label") == HOME_LABEL), None)
    return home, [w for w in ws if w is not home]


def order_rows(labelled, open_ws):
    """(label, path, touched) rows: open projects first in sidebar order, then
    the rest by most recently touched. Open workspaces with no matching repo are
    not listed (they still get closed on accept, since they cannot be selected).

    The touch time is carried on the row rather than looked up again later.
    touched_at() walks each working tree, which is the single largest cost of
    starting the picker, so every repo is walked exactly once per run: sorting
    needs the value here and build_lines() needs it for the TOUCHED column.
    """
    by_label = dict(labelled)
    head = [(w["label"], by_label[w["label"]], touched_at(by_label[w["label"]]))
            for w in open_ws if w["label"] in by_label]
    listed = {l for l, _, _ in head}
    rest = sorted(((l, p, touched_at(p)) for l, p in labelled if l not in listed),
                  key=lambda r: -r[2])
    return head, rest


def preselect_bind(n):
    """fzf --bind that marks the first n rows selected once the list is loaded.

    Must be the load event: start fires before any rows exist, so pos+select
    there is a silent no-op (verified against fzf 0.74 in a pty). load fires
    exactly once for a static list and does not re-fire when the query changes,
    so the positional selects cannot leak onto filtered rows (counted with
    execute-silent in a pty on 0.74.3)."""
    if n <= 0:
        return []
    chain = "+".join(f"pos({i})+select" for i in range(1, n + 1))
    return ["--bind", f"load:{chain}+pos(1)"]


def parse_selection(returncode, stdout):
    """None = cancelled (leave everything alone). [] = deliberately empty.
    Otherwise the chosen repo paths."""
    if returncode == 130:
        return None
    lines = stdout.splitlines()
    if EMPTY in lines:
        return []
    # Split on every tab, not just the first: field 3 (the untruncated label)
    # follows the path, and a maxsplit of 1 would hand back "path\tlabel".
    paths = [f[1] for f in (l.split("\t") for l in lines) if len(f) > 1 and f[1]]
    return paths or None


def plan(selected_labels, open_ws):
    """What to close and what to create so open == selected."""
    keep = set(selected_labels)
    to_close = [w for w in open_ws if w["label"] not in keep]
    open_labels = {w["label"] for w in open_ws}
    to_create = [l for l in selected_labels if l not in open_labels]
    return to_close, to_create


def pick_focus(created_ids, closed_ids, focused_id, surviving_ids, home_id):
    """Newly created wins. If the focused workspace was closed, fall back to the
    first surviving selection, then home. Otherwise leave focus alone."""
    if created_ids:
        return created_ids[-1]
    if focused_id in closed_ids:
        return surviving_ids[0] if surviving_ids else home_id
    return None


def canonical_theme(name):
    """A config theme name folded to its canonical key, or None if unknown.

    Port of canonical_theme_name (src/config/theme.rs:25): lowercase, then
    spaces and underscores to hyphens, then the alias table.
    """
    key = re.sub(r"[ _]", "-", (name or "").strip().lower())
    key = THEME_ALIASES.get(key, key)
    return key if key in PALETTES else None


def parse_color(value):
    """A config colour string as a ratatui colour, in the picker's own shape:
    an int (a 256-colour index) or an (r, g, b) triple.

    Port of parse_color (src/config/theme.rs:155), including its final branch:
    an unrecognised value is cyan, NOT an error. Diverging there would colour a
    typo differently from the sidebar it is meant to match.
    """
    s = (value or "").strip().lower()
    if s in RESET_ALIASES:
        return None                       # SGR 39, the default foreground
    if s.startswith("#"):
        hexpart = s[1:]
        if len(hexpart) == 6 and re.fullmatch(r"[0-9a-f]{6}", hexpart):
            return tuple(int(hexpart[i:i + 2], 16) for i in (0, 2, 4))
        if len(hexpart) == 3 and re.fullmatch(r"[0-9a-f]{3}", hexpart):
            return tuple(int(c, 16) * 17 for c in hexpart)
    m = re.fullmatch(r"rgb\(([^)]*)\)", s)
    if m:
        parts = [p.strip() for p in m.group(1).split(",")]
        if len(parts) == 3 and all(p.isdigit() and int(p) < 256 for p in parts):
            return tuple(int(p) for p in parts)
    return NAMED_COLORS.get(s, NAMED_COLORS["cyan"])


# Every config key resolve_theme() reads, built from the tables above so a role
# added there cannot be silently left unreadable.
THEME_KEYS = frozenset(
    ["ui.status_indicators", "theme.name", "theme.auto_switch", "theme.dark_name"]
    + [f"theme.custom.{r}" for r in STATUS_ROLE_ORDER]
    + [f"theme.custom.dark.{r}" for r in STATUS_ROLE_ORDER])


def herdr_rejects_theme(field):
    """True when Herdr itself will not accept the theme name at `field`.

    `herdr config check` diagnoses an unknown theme name, naming both the field
    and the fallback it uses ("unknown theme name theme.name = ...; using
    "catppuccin""). That is the only way to tell a TYPO apart from a theme newer
    than PALETTES: on a typo Herdr draws its own default, so matching it means
    drawing that default too, while a name Herdr accepts and this table lacks
    means the table is stale.

    Called only when PALETTES has no entry for the name, so the normal path
    never pays for the subprocess. Any failure answers False, which routes to
    UNKNOWN_THEME: a picker that cannot ask must not claim the name was a typo.
    """
    try:
        r = subprocess.run([HERDR, "config", "check"], capture_output=True, text=True)
    except OSError:
        return False
    return f"unknown theme name {field}" in (r.stdout + r.stderr)


def resolve_theme(config=None, rejects=None):
    """(icons, colours) for the current Herdr config.

    `icons` maps a status to its glyph, `colours` maps a status to a colour in
    parse_color()'s shape. Reads [ui] status_indicators, [theme] name, and any
    [theme.custom] override of the five status roles.

    auto_switch is the one thing this cannot follow. Herdr picks between
    dark_name and light_name from the HOST TERMINAL's appearance, which it
    learns over the client connection and does not expose on the API or the
    CLI. A popup pane has no way to ask. When auto_switch is on, dark_name is
    used (Herdr's own dark default, and the overwhelmingly common case for a
    terminal), and [theme.custom.dark] overrides are applied with it.
    """
    if config is None:
        config = read_toml(herdr_config_path(), THEME_KEYS)
    rejects = rejects or herdr_rejects_theme
    style = config.get("ui.status_indicators", "dots")
    icons = STATUS_ICONS.get(style, STATUS_ICONS["dots"])

    auto = config.get("theme.auto_switch", "false").strip().lower() == "true"
    field = "theme.dark_name" if auto else "theme.name"
    name = config.get(field)
    key = canonical_theme(name)
    if key is None:
        # Unset means Herdr's default. A name Herdr also rejects means Herdr is
        # drawing that same default, so match it. A name Herdr accepts and this
        # table lacks is a stale table, which is what UNKNOWN_THEME is for.
        key = DEFAULT_THEME if not name or rejects(field) else UNKNOWN_THEME
    palette = PALETTES[key]

    roles = dict(zip(STATUS_ROLE_ORDER, palette))
    # A mode override wins over the unqualified one, matching the order
    # with_overrides() applies them (src/app/state.rs:551).
    tables = ["theme.custom"] + (["theme.custom.dark"] if auto else [])
    for role in STATUS_ROLE_ORDER:
        for table in tables:
            if f"{table}.{role}" in config:
                roles[role] = config[f"{table}.{role}"]

    colours = {}
    for status, role in STATUS_ROLES.items():
        value = roles[role]
        # A built-in Rgb is already in shape; a named colour and every config
        # override are strings that still need parsing.
        colours[status] = value if isinstance(value, tuple) else parse_color(value)
    return icons, colours


def paint(text, colour):
    """`text` wrapped in the SGR foreground escape ratatui would have written."""
    if colour is None:
        code = "39"
    elif isinstance(colour, tuple):
        code = "38;2;%d;%d;%d" % colour
    else:
        code = f"38;5;{colour}"
    return f"\033[{code}m{text}\033[39m"


def status_cell(status, icons, colours):
    """The AGENT STATUS column for one open workspace: Herdr's glyph and colour,
    then the status word.

    The word is kept even though Herdr's sidebar shows the glyph alone, because
    fzf searches the visible text: typing "blocked" has to narrow the list. The
    visible text is padded to STATUS_WIDTH before the escapes go on, since ROW
    cannot pad a string whose length it would measure wrongly.
    """
    icon = icons.get(status, icons["unknown"])
    # .get() would be wrong here: a reset colour is legitimately None, so a
    # status Herdr adds later must fall back explicitly, not by absence.
    colour = colours[status] if status in colours else colours["unknown"]
    return paint(f"{icon} {status}".ljust(STATUS_WIDTH), colour)


def build_lines(rows, status, now):
    """One fzf input line per (label, path, touched) row, in the order given.

    Field 1 holds the visible columns, with the label elided so a long name
    cannot push the columns after it out of alignment. Fields 2 and 3 are
    hidden payload the preview reads: the repo path, then the label again,
    untruncated, since field 1 may have lost the end of it.

    `status` maps an open workspace's label to its rendered AGENT STATUS cell,
    already glyphed, coloured and padded by status_cell(). A row absent from it
    is not open and gets a blank column.

    The touch time arrives on the row from order_rows(). Nothing here may reach
    for the filesystem to recompute it: doing so walks every working tree a
    second time and doubles the wait before the picker paints.
    """
    lines = []
    for label, path, touched in rows:
        lines.append(ROW.format(elide(label, LABEL_WIDTH), row_kind(path),
                                human_age(touched, now), status.get(label, ""),
                                path, label))
    return lines


def open_project(label, path):
    """Ask Herdr to open `path` as a workspace; its result, or None on failure.

    A linked worktree goes through `worktree open`, which is the only command
    that records which repo the checkout belongs to. `workspace create` records
    nothing, so a worktree opened with it carries no repo metadata at all and
    Herdr's sidebar has nothing to group it by: it floats at top level as if it
    were an unrelated project, while the same worktree opened by Herdr itself
    nests under its repo. That was true of every worktree the picker opened, in
    every layout, not only the nested ones.

    The parent is named by PATH (--cwd), not by workspace id. The id form would
    need the parent's own workspace open, and opening one the user did not check
    would break this picker's contract that the selection is the truth.

    `worktree open` returns the same workspace the create call does, so the
    caller hands either answer to the layout identically.

    Falls back to `workspace create` in both the cases where the nesting cannot
    be had: a checkout whose parent parent_repo() cannot derive, and a Herdr too
    old to carry the command — min_herdr_version is 0.8.0 and this is not worth
    raising, since the fallback opens the worktree exactly as every version of
    this picker already did. Only the fallback failing is fatal, which is the
    same failure the caller has always died on.
    """
    parent = parent_repo(path)
    if parent:
        res = herdr("worktree", "open", "--cwd", parent, "--path", path,
                    "--label", label, "--no-focus")
        if res:
            return res
    return herdr("workspace", "create", "--cwd", path, "--label", label, "--no-focus")


def layout_command():
    """The sibling plugin's bin/agent-layout, or None when it cannot be run.

    The path is asked for rather than guessed at. `herdr plugin list` reports
    every linked plugin's own checkout as `plugin_root`, which is the only thing
    that knows where the sibling was installed — it may be a GitHub install
    under Herdr's own directory or a local link anywhere on the disk. The
    picker's own root says nothing about it, and neither does the config
    directory, which is Herdr's and not the plugin's.

    Filtered with --plugin so the answer is one plugin or nothing at all. --json
    is needed HERE and nowhere else in this file: `plugin list` prints a human
    table by default, unlike `workspace list` and the other commands herdr()
    parses, and 0.8.2 answers an unknown id with an empty list rather than an
    error.

    Executable, not merely present: the sibling is run as a program, so a file
    that lost its mode bit is exactly as unusable as an absent one and the
    caller's degraded path is right for both. `enabled` is deliberately NOT
    consulted. `plugin disable` stops Herdr DISPATCHING EVENTS to a plugin,
    which is the sibling's other way in; this is a direct call to an executable
    and is not dispatch. Refusing to lay out a picker workspace because the
    sibling's event hook was turned off would be a surprise from a plugin the
    user did not touch.
    """
    plugins = (herdr("plugin", "list", "--plugin", LAYOUT_PLUGIN, "--json")
               or {}).get("plugins", [])
    for p in plugins:
        root = p.get("plugin_root") or ""
        command = os.path.join(root, "bin", "agent-layout")
        if root and os.access(command, os.X_OK):
            return command
    return None


def resolve_layout(creating):
    """The layout command for this whole run, saying so once when there is none.

    `creating` is whether anything is actually being opened. Nothing is asked of
    Herdr when it is false, so a selection that only closes workspaces costs no
    `plugin list` call and raises no notice about a layout it was never going to
    apply.

    The notice is per RUN, not per workspace. The sibling is a separate install
    that nothing here declares a dependency on, so its absence is a legitimate
    state rather than an error — but a silent one would leave the user looking
    at a bare pane with nothing to explain it. N toasts for one missing install
    would bury the projects they just asked for, which is why this is resolved
    here rather than inside create_workspace().
    """
    if not creating:
        return None
    command = layout_command()
    if not command:
        warn(f"{LAYOUT_PLUGIN} is not installed, so new workspaces open with "
             "one bare pane and no agent. Install it to get the agent, tool "
             "and shell panes back.")
    return command


def layout_env(command):
    """The environment `command` is run with: this one, with two corrections.

    HERDR_PLUGIN_ROOT is pointed at the SIBLING's checkout. The sibling reads it
    to find its own bin/config-env, and Herdr injects THIS plugin's root into
    the picker, which would send it looking in the wrong repo. Deriving it from
    the command keeps the two from disagreeing.

    HERDR_PLUGIN_CONFIG_DIR is removed, for the mirror-image reason: the sibling
    takes it as "your config directory" and only asks Herdr for its own when the
    variable is absent. Left in place, it would read THIS plugin's .env as
    though it were its own.

    Everything else passes through, which is what keeps the shared AGENT_LAYOUT_
    vocabulary working. A name exported in the real environment, or set in this
    plugin's .env — which the loaders at the top of this file fold into
    os.environ — arrives as a real environment variable and beats the sibling's
    .env, so a value set for the picker still shapes the picker's workspaces.
    """
    env = dict(os.environ)
    env.pop("HERDR_PLUGIN_CONFIG_DIR", None)
    env["HERDR_PLUGIN_ROOT"] = os.path.dirname(os.path.dirname(command))
    return env


def create_workspace(label, path, layout):
    """Open a workspace for `path` and have it laid out; its workspace id.

    `layout` is layout_command()'s answer: the sibling plugin's bin/agent-layout,
    or None when it is not installed, in which case the workspace still opens —
    with the one bare pane Herdr gives it — and nothing else happens here. The
    caller says so once per run rather than once per workspace.

    The layout itself is not built here and must not be. The sibling owns that
    recipe, applies it to worktrees it creates from an event and to a keybinding
    press, and reads the ten AGENT_LAYOUT_ settings that shape it. A second copy
    of the same sequence in this file is what this call replaces.

    ONE ARGUMENT IS PASSED, and it is the only one this caller cannot give up:

      --workspace   the picker opens every workspace with --no-focus, so at the
                    moment it wants one laid out, none of them is focused —
                    which is what agent-layout asks the API for by default.

    THE AGENT NAME IS NOT PASSED, and that is what opts this picker into the
    sibling's dedupe. Given --agent-name, the sibling hands that name to Herdr
    verbatim and fails loudly when a live agent already holds it. Left off, it
    derives the name from the workspace label — by the same rules this file used
    to apply — and retries as base-2, base-3 and so on when Herdr answers
    agent_name_taken. That arbitration is the SERVER's, so it holds across the
    unrelated processes this caller fires detached, and against an agent a human
    started by hand. A set held in this one process could do neither.

    --no-agent is the other absent flag, and is deliberately NOT passed. It is
    mutually exclusive with the agent, and this is the shape that detaches the
    WHOLE call. The other shape — agent-layout run synchronously with
    --no-agent, and `agent start` detached here — works too, and would put ten
    herdr round trips back on the critical path of a multi-select for no gain.

    DETACHED for the same reason the bare `agent start` was before it:
    `agent start` blocks until the agent is ready, 30s by default, and
    --timeout cannot be cut below its 3000ms minimum. Waiting on that once per
    selected project is the stall this picker exists not to have. The layout is
    therefore fire-and-forget, and the sibling reports its own failures as Herdr
    toasts, which is more than the inline copy ever did.

    Nothing about the handoff is fatal, unlike the create above: a layout that
    does not happen leaves a usable workspace, and dying over it would abandon
    the rest of a multi-select.

    Herdr emits worktree.opened for the call open_project() makes, and the
    sibling does subscribe to that event — but it cannot act on it twice over.
    Its hook exits on two gates before reaching the layout: the event is not
    worktree.created, and the workspace is not focused, which a --no-focus open
    never is. So this call stays the only thing laying the workspace out.

    `label` is still taken, and is still what open_project() names the workspace
    with. That label is what the sibling derives the agent name from, so naming
    the workspace correctly here is the whole of this file's remaining part in
    naming the agent.
    """
    res = open_project(label, path)
    if not res:
        die(f"failed to create workspace for {path}")

    workspace = res["workspace"]["workspace_id"]
    if layout:
        subprocess.Popen([layout, "--workspace", workspace],
                         env=layout_env(layout), start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return workspace


def main():
    if not HERDR:
        die("herdr not found on PATH")
    ensure_fzf()

    # Timed here, and reported here, because this is the one startup cost that
    # varies with the shape of the tree. perf_counter() rather than time(): it
    # is monotonic, so a clock adjustment mid-run cannot produce a negative
    # figure. Reported before the empty check below, since "0 rows" is exactly
    # the case worth seeing, and long before fzf takes the screen.
    counts = {}
    started = time.perf_counter()
    paths = repos(counts)
    debug_discovery(time.perf_counter() - started, paths, counts)

    if not paths:
        die(f"No git repositories found under {DEV}")

    # Basenames appearing more than once get a parent prefix to stay unique.
    seen, dupes = set(), set()
    for p in paths:
        b = os.path.basename(p)
        (dupes if b in seen else seen).add(b)

    def label_for(p):
        b = os.path.basename(p)
        return f"{os.path.basename(os.path.dirname(p))}/{b}" if b in dupes else b

    _, open_ws = open_workspaces()
    icons, colours = resolve_theme()
    status = {w["label"]: status_cell(w.get("agent_status", "unknown"), icons, colours)
              for w in open_ws}
    head, rest = order_rows([(label_for(p), p) for p in paths], open_ws)

    lines = build_lines(head + rest, status, time.time())

    sel = subprocess.run(
        # --ansi: the AGENT STATUS cell carries Herdr's own colour escapes.
        # Without it fzf prints them literally and the columns fall apart.
        ["fzf", "--ansi", "--delimiter=\t", "--with-nth=1", "--nth=1", "--layout=reverse",
         "--multi", "--prompt=filter projects > ",
         "--header=" + HEADER,
         "--bind", KEYS,
         "--bind", f"enter:transform:[ \"$FZF_SELECT_COUNT\" -eq 0 ] "
                   f"&& echo 'print({EMPTY})+accept' || echo accept",
         *preselect_bind(len(head)),
         "--header-lines=1",
         # No pointer glyph: the whole current row is highlighted instead.
         # Selected rows get a green check; fzf has no unselected marker, so
         # that column is simply blank on the rest.
         "--marker=\u2713 ", "--color=marker:green",
         "--pointer= ", "--gutter= ", "--highlight-line",
         "--height=100%", "--info=inline",
         # The label heads the preview because field 1 may be elided: this is
         # the only place a truncated name can be read in full. fzf quotes {3}
         # and {2} for the shell, so no quoting is needed around them here.
         "--preview", "printf '%s\\n\\n' {3}; "
                      "git -C {2} log --oneline -8 2>/dev/null || ls -1 {2}",
         "--preview-window=right:52%:wrap"],
        input="\n".join([HEADING] + lines), capture_output=True, text=True)

    chosen = parse_selection(sel.returncode, sel.stdout)
    if chosen is None:
        return

    # Re-read: the list may have changed while the picker was open.
    home, open_ws = open_workspaces()
    selected = [label_for(p) for p in chosen]
    to_close, to_create = plan(selected, open_ws)
    path_of = {label_for(p): p for p in chosen}

    closed = []
    for w in to_close:
        if herdr("workspace", "close", w["workspace_id"]) is not None:
            closed.append(w["workspace_id"])

    layout = resolve_layout(bool(to_create))
    created = [create_workspace(label, path_of[label], layout)
               for label in to_create]

    focused = next((w["workspace_id"] for w in open_ws if w.get("focused")), None)
    surviving = [w["workspace_id"] for w in open_ws
                 if w["label"] in set(selected) and w["workspace_id"] not in closed]
    target = pick_focus(created, closed, focused, surviving,
                        home["workspace_id"] if home else None)
    if target:
        subprocess.run([HERDR, "workspace", "focus", target], capture_output=True)


if __name__ == "__main__":
    # --check-deps is the manifest's [[build]] entry point. It must never open
    # the picker: a build step has no terminal to draw one in.
    if "--check-deps" in sys.argv[1:]:
        sys.exit(check_deps())
    main()
