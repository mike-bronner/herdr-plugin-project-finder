# Key bindings and the legend above the list. Space is deliberately NOT bound:
# it is fzf's AND separator between query terms, so binding it to toggle flips
# rows while you type a multi-word filter. Tab is fzf's own toggle key and is
# left at its default. The legend must keep agreeing with what is bound here.
KEYS = "ctrl-a:select-all,ctrl-d:deselect-all"
