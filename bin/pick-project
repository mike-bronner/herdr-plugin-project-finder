#!/usr/bin/env python3
"""Fuzzy-pick git repos under a root folder and make them the open Herdr workspaces.

The list is the desired set of open projects. Everything already open (other
than the pinned home workspace) is listed first and pre-selected, so what you
see checked is exactly what is loaded. On Enter the selection becomes the
truth: deselected projects are closed, newly selected ones are created, and an
empty selection closes every project so only home remains. Esc changes nothing.

The search root is HERDR_PICKER_ROOT, defaulting to the home folder. The home
workspace (label "~", override with HERDR_PICKER_HOME) is never listed and
never closed. Setting HERDR_PICKER_DEBUG reports what finding the repos cost,
on one line; unset, the picker writes nothing at all.

Every setting may also come from a file under HERDR_PLUGIN_CONFIG_DIR: a
[picker] table in this plugin's own config.toml, or the older .env. Both are
optional and both still work. Precedence is real environment variable, then
config.toml, then .env — see load_picker_config() for why in that order.

Each open project's row carries its agent status, drawn with the glyph and
colour Herdr's own sidebar would use, read out of Herdr's config.toml. See the
"Herdr's agent-status indicator" section below.

Each new workspace opens one tab holding three labelled panes, with the cursor
on the agent: by default a tab named "agent", Claude on the left at half the
width, lazygit filling the top 60% of the column beside it, and a bare shell
underneath. The picker does not build that itself. It hands each workspace it
opens to the sibling herdr-plugin-agentic-panes-layout plugin's bin/agent-layout,
which owns the recipe, the ten AGENT_LAYOUT_ settings that shape it, and the
agent's name — see create_workspace() for the handoff and layout_command() for
how the sibling is found. Claude is started plain: Herdr's own [session]
resume_agents_on_restore (on by default) brings conversations back after a
server restart, so nothing here passes --continue.

A linked worktree is opened as a worktree rather than as a bare directory, so
Herdr's sidebar nests it under the repo it belongs to instead of floating it at
top level. See open_project().
"""
import glob, json, os, re, shutil, subprocess, sys, time


def load_env(path):
    """Apply KEY=VALUE lines from `path` to os.environ. Real env vars win.

    Blank lines and lines starting with "#" are skipped, and so is any line
    without an "=". The skip is deliberate: the file is optional user config,
    so a typo must never stop the picker from opening.
    """
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key, value = key.strip(), value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        if key:
            os.environ.setdefault(key, value)


def read_toml(path, wanted):
    """Values for the "table.key" names in `wanted`, as raw strings.

    A deliberate subset of TOML: scalar values under [table] headers, which is
    every setting read here. Arrays, inline tables and multi-line values are
    skipped rather than half-parsed, and an unreadable file yields {}. Python
    3.9 ships no tomllib and this plugin has no dependencies, so a full parser
    would have to be vendored to read four keys.

    Like load_env(), nothing here may raise: Herdr's config is the user's to
    edit, and a syntax error in it must never stop the picker from opening.
    """
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return {}
    found, table = {}, ""
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            table = line[1:-1].strip().strip('"')
            continue
        key, sep, value = line.partition("=")
        name = f"{table}.{key.strip()}"
        if not sep or name not in wanted:
            continue
        value = value.strip()
        if value[:1] in "\"'":
            # Quoted: take up to the closing quote, so a trailing comment that
            # contains no quote cannot be glued onto the value.
            end = value.find(value[0], 1)
            value = value[1:end] if end > 0 else value[1:]
        else:
            value = value.partition("#")[0].strip()
        if value and not value.startswith(("[", "{")):
            found.setdefault(name, value)
    return found


# The [picker] table in this plugin's own config.toml, mapped to the environment
# variable each key stands in for. One table, because the plugin owns the whole
# file and has nothing else to keep in it.
PICKER_KEYS = {"picker.root": "HERDR_PICKER_ROOT",
               "picker.home": "HERDR_PICKER_HOME",
               "picker.debug": "HERDR_PICKER_DEBUG"}


def load_picker_config(path):
    """Apply the [picker] table in `path` to os.environ. Real env vars win.

    `path` is this plugin's OWN config.toml, in the directory Herdr hands the
    plugin. Herdr's config.toml is not the place for these: its schema names no
    plugin table, so a section added there makes `herdr config check` report
    issues for good. The plugin docs say to put user config in the plugin config
    dir and leave the format to the plugin, which is what this is.

    Call this BEFORE load_env(), which is the whole of why config.toml beats a
    .env naming the same setting. Both apply values with setdefault(), so the
    first writer wins and a real environment variable, already in os.environ,
    got there before either. TOML is the format these settings are moving to, so
    a .env left behind must not quietly outrank the file that replaced it.

    Like load_env(), nothing here may raise: read_toml() answers {} for a file
    that is missing or unreadable and skips a line it cannot parse, so a typo in
    this file must never stop the picker from opening.
    """
    config = read_toml(path, frozenset(PICKER_KEYS))
    if "picker.debug" in config:
        # A TOML boolean arrives as the raw string "true" or "false" — the same
        # shape resolve_theme() reads auto_switch in, so it is read the same way
        # rather than a second idiom being invented for one key. The flag itself
        # is a plain truthy environment variable, and "false" is a non-empty
        # string, so it has to become the empty one here or `debug = false` would
        # switch debugging ON. Empty is still SET rather than skipped, so an
        # explicit false beats a stale HERDR_PICKER_DEBUG in a .env.
        on = config["picker.debug"].strip().lower() == "true"
        config["picker.debug"] = "1" if on else ""
    for key, var in PICKER_KEYS.items():
        if key in config:
            os.environ.setdefault(var, config[key])


def herdr_config_path():
    """Herdr's own config.toml.

    HERDR_CONFIG_PATH wins, because Herdr documents it as the override for this
    exact file (`herdr --help`) and the server is reading whatever it names.
    Otherwise it is derived from the plugin config dir Herdr passes in, which is
    <config root>/plugins/config/<plugin id>, so a relocated config root is
    followed rather than guessed at. Failing both, the documented default.
    """
    override = os.environ.get("HERDR_CONFIG_PATH")
    if override:
        return os.path.expanduser(override)
    d = os.environ.get("HERDR_PLUGIN_CONFIG_DIR")
    if d:
        root = os.path.dirname(os.path.dirname(os.path.dirname(d.rstrip(os.sep))))
        candidate = os.path.join(root, "config.toml")
        if os.path.isfile(candidate):
            return candidate
    return os.path.expanduser("~/.config/herdr/config.toml")


# Container paths a linked worktree sits in, each RESOLVED AGAINST the root of
# the repo it belongs to. The rule is the resolution, not the destination: all
# three fixed names land inside the repo, but a "../x" added by the setting
# below lands beside it, and repos() searches whatever the join produces.
# ".worktrees" is Herdr's own layout while [worktrees] directory is ".worktrees",
# ".claude/worktrees" is Claude Code's, and "worktrees" is the same idea spelled
# without the dot. Fixed names rather than a search: see repos() for what looking
# harder costs.
FIXED_WORKTREE_DIRS = (".worktrees", ".claude/worktrees", "worktrees")


def worktree_locations(config=None):
    """(dirs, roots): the two shapes a linked worktree is kept in.

    `dirs` are RELATIVE paths, each resolved against every repo that was found.
    A leading "../" is therefore not a special case here: it resolves to a
    directory BESIDE the repo instead of inside it, and repos() searches it the
    same way. `roots` are absolute directories holding worktrees for many repos,
    searched on their own because they may sit outside the picker root entirely.

    On top of the fixed names, Herdr's own [worktrees] directory is read, so
    the picker follows the setting instead of guessing at it — while never
    depending on that one setting, which is why the fixed names stay. Herdr
    resolves a relative value against each repo root, which is exactly a
    container, so it joins `dirs`; an absolute one (Herdr's shipped default is
    ~/.herdr/worktrees) is a flat root and joins `roots`.

    Like read_toml() itself, nothing here may raise: an unset, unreadable or
    malformed setting simply contributes nothing and the fixed names remain.
    """
    if config is None:
        config = read_toml(herdr_config_path(), {"worktrees.directory"})
    setting = os.path.expanduser(config.get("worktrees.directory", "").strip())
    dirs, roots = list(FIXED_WORKTREE_DIRS), []
    if os.path.isabs(setting):
        roots.append(os.path.normpath(setting))
    elif setting:
        # normpath so "./trees" and "trees" cannot both be searched. A "../x"
        # is kept, and normpath keeps its leading "..": Herdr resolves the value
        # against the repo root too, so "../worktrees" names a real container
        # beside the repo rather than a nonsense one. That is the layout Herdr
        # moved to so that no filesystem-walking tool descends into a worktree,
        # and repos() carries the two consequences of it — the container is
        # SHARED by every repo in that parent, and it can fall inside the depth
        # bands' reach because it has no leading dot.
        norm = os.path.normpath(setting)
        if norm not in dirs:
            dirs.append(norm)
    return dirs, roots


def resolve_root():
    """Where to look for repos: HERDR_PICKER_ROOT, else the home folder.

    A leading "~" is expanded, since neither config file has its values
    shell-expanded, whichever of the two supplied this one. A root that is not
    an existing directory falls back to the home folder rather than dying, so a
    stale override still leaves the picker usable.
    """
    root = os.path.expanduser(os.environ.get("HERDR_PICKER_ROOT") or "~")
    return root if os.path.isdir(root) else os.path.expanduser("~")


# User-editable config lives in the plugin's config dir, per the Herdr docs.
# Loaded before the settings below so the files can supply them. config.toml is
# read FIRST because both loaders use setdefault(): see load_picker_config().
if os.environ.get("HERDR_PLUGIN_CONFIG_DIR"):
    load_picker_config(os.path.join(os.environ["HERDR_PLUGIN_CONFIG_DIR"], "config.toml"))
    load_env(os.path.join(os.environ["HERDR_PLUGIN_CONFIG_DIR"], ".env"))

DEV = resolve_root()
HOME_LABEL = os.environ.get("HERDR_PICKER_HOME", "~")

# Bound here, beside DEV, for the same two reasons: the files above may supply
# the variables herdr_config_path() reads, and Herdr's config must be read once
# per run rather than once per repo — touched_at() consults these too.
WORKTREE_DIRS, WORKTREE_ROOTS = worktree_locations()

# Column layout for the list. The heading is built from the same format string
# as every row, so the two cannot drift out of alignment. Only field 1 is shown
# (--with-nth=1); the two tab-separated fields after it are hidden payload that
# the preview reads — field 2 is the repo path, field 3 the untruncated label.
#
# Field 3 exists for the preview alone, NOT for filtering. fzf calculates --nth
# against the transformed line, so a hidden field cannot be searched at all:
# "fzf doesn't allow searching against the hidden fields" (fzf(1), --nth). The
# preview is the exception, and reads fields from the original line. So a label
# elide() cuts is unmatchable past the ellipsis, and the preview showing it in
# full is the compensation.
#
# KIND is spelled out rather than iconified because fzf searches the visible
# field, so typing "worktree" filters the list to worktrees.
LABEL_WIDTH = 34
STATUS_WIDTH = 12
ROW = f"{{:<{LABEL_WIDTH}}} {{:<9}} {{:<9}} {{}}\t{{}}\t{{}}"
HEADING = ROW.format("PROJECT", "KIND", "TOUCHED", "AGENT STATUS", "", "")

# The AGENT STATUS field is NOT padded by ROW. It carries colour escapes, and
# str.format pads by character count, so a padded format spec would count the
# escapes and pad by the wrong amount. status_cell() pads the visible text to
# STATUS_WIDTH before wrapping it. Nothing visible follows the field, so this
# costs no alignment either way — it is done so the width stays one number.

