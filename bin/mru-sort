#!/usr/bin/env python3
"""Promote a workspace to the top of the sidebar once dwelled in for N seconds.

Fires on every workspace.focused event. Herdr has no timer event, so the hook
stamps state, returns immediately, and hands off to a DETACHED child that sleeps
for the dwell period and then promotes — provided focus never moved.

A generation counter makes rapid switching safe: each focus event bumps it, and
a waking child that finds a newer generation exits without touching anything.
The parent never blocks, so the event hook cannot stall Herdr's UI.

The pinned workspace (default: home, label "~") is always held at index 0.
"""
import json, os, socket, subprocess, sys, time, itertools

DWELL_SECONDS = float(os.environ.get("HERDR_MRU_DWELL", "10"))
PINNED_LABEL = os.environ.get("HERDR_MRU_PIN", "~")
PROMOTE_INDEX = 1                      # index 0 belongs to the pin

STATE_DIR = os.environ.get("HERDR_PLUGIN_STATE_DIR") or os.path.expanduser("~/.config/herdr")
STATE = os.path.join(STATE_DIR, "mru-state.json")
SOCK = os.path.expanduser("~/.config/herdr/herdr.sock")
_ids = itertools.count(1)

def call(method, params=None):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(5)
    try:
        s.connect(SOCK)
        s.sendall((json.dumps({"id": f"mru-{next(_ids)}", "method": method,
                               "params": params or {}}) + "\n").encode())
        buf = b""
        while b"\n" not in buf:
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
        return json.loads(buf.split(b"\n")[0].decode())
    finally:
        s.close()

def workspaces():
    return call("workspace.list").get("result", {}).get("workspaces", [])

def read_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except Exception:
        return {}

def write_state(d):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f)
    os.replace(tmp, STATE)

def hold_pin(ws, order):
    """Keep the pinned workspace at index 0."""
    pin = next((w["workspace_id"] for w in ws if w.get("label") == PINNED_LABEL), None)
    if pin and order and order.index(pin) != 0:
        try:
            call("workspace.move", {"workspace_id": pin, "insert_index": 0})
        except Exception:
            pass
    return pin

def on_focus():
    """Runs synchronously on the event. Stamps state, spawns the waiter, exits."""
    ws = workspaces()
    if not ws:
        return
    order = [w["workspace_id"] for w in ws]
    pin = hold_pin(ws, order)

    current = next((w["workspace_id"] for w in ws if w.get("focused")), None)
    if not current or current == pin:
        return

    gen = int(read_state().get("generation", 0)) + 1
    write_state({"workspace_id": current, "since": time.time(), "generation": gen})

    # Detached: parent must not block Herdr's event pipeline for the dwell period.
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "--await", str(gen)],
                     start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def await_dwell(gen):
    """Runs detached. Promotes only if focus never moved during the dwell."""
    time.sleep(DWELL_SECONDS)

    state = read_state()
    if int(state.get("generation", -1)) != gen:
        return                                  # focus moved on; a newer child owns this

    target = state.get("workspace_id")
    ws = workspaces()
    if not ws or not target:
        return

    live = {w["workspace_id"]: w for w in ws}
    if target not in live or not live[target].get("focused"):
        return                                  # closed, or no longer focused

    order = [w["workspace_id"] for w in ws]
    pin = hold_pin(ws, order)
    if target == pin:
        return

    if order.index(target) != PROMOTE_INDEX:
        try:
            call("workspace.move", {"workspace_id": target, "insert_index": PROMOTE_INDEX})
        except Exception:
            pass

if __name__ == "__main__":
    try:
        if len(sys.argv) > 2 and sys.argv[1] == "--await":
            await_dwell(int(sys.argv[2]))
        else:
            on_focus()
    except Exception as e:
        print(f"mru-sort: {e}", file=sys.stderr)
    sys.exit(0)   # never fail the event hook
